# .env de cada Raspberry (coletor)
COMPOSE_PROFILES=coletor

# O id do coletor é o hostname da máquina: cada Raspberry precisa de um hostname único
# (sudo hostnamectl set-hostname coletor-sala-1)
# COLETOR_ID=coletor-sala-1  # opcional: vence o hostname (ex.: dois coletores na mesma máquina em teste)
TARGET_ADDRESS=A0:9E:1A:XX:XX:XX
SCAN_TIMEOUT=10
CONNECT_TIMEOUT=20
RSSI_INTERVALO=1
RSSI_MAX_FALHAS=3          # falhas seguidas de RSSI até derrubar a conexão e reconectar
RECONEXAO_MAX_TENTATIVAS=5 # Tentativas por queda antes de liberar a posse
RECONEXAO_INTERVALO=3 # segundos entre as tentativas de reconexão
FC_TEMPO_SEM_LEITURA=5
FC_MAX_LEITURAS_SEM_BROKER=15 # Leituras de FC guardadas sem broker
PRESENCA_INTERVALO_COLETOR=5.0 # também é o keepalive MQTT (RF11)

BROKER_HOST=192.168.0.10           # IP da máquina central
BROKER_PORTA=1883
BROKER_USUARIO=
BROKER_SENHA=
BROKER_INTERVALO_RECONEXAO=5
PRAZO_SEM_BROKER=15        # s sem broker, com a pulseira conectada, até soltá-la para a disputa (RF11)
MINIMO_AMOSTRAS=5          # ajustar depois de medir os anúncios por segundo
FATOR_EXTENSAO_JANELA=3

VARREDURA_TEMPO_AUSENCIA=5

LIMIAR_CONEXAO_FRACA=-78   # dBm; coordenador (conexao-fraca) e painel (divisa entre fraco e crítico)

# Painel (RF20), na máquina central (COMPOSE_PROFILES=central)
# PULSEIRAS=A0:9E:1A:XX:XX:XX,A0:9E:1A:YY:YY:YY  # pulseiras exibidas; sem ela, usa TARGET_ADDRESS
PAINEL_PORTA=8765
PAINEL_JANELA_MEDIANA=3    # leituras de RSSI na mediana exibida em destaque
PAINEL_SIMULADO=0          # 1: dois coletores e um coordenador falsos publicam uma pulseira simulada (não use com o coordenador real)
# PAINEL_HOST=0.0.0.0      # endereço de escuta do servidor web
# PAINEL_ID=painel-central # opcional: client id MQTT (padrão: painel-<hostname>)
